<% content_for :title, "Dashboard | Digital Custody" %>

<header class="page-header">
  <div>
    <p class="eyebrow">Resumen operativo</p>
    <h1>Dashboard</h1>
  </div>
</header>

<section class="stats-grid">
  <article class="stat-card"><span>Casos abiertos</span><strong><%= @open_cases_count %></strong></article>
  <article class="stat-card"><span>Evidencias totales</span><strong><%= @evidences_count %></strong></article>
  <article class="stat-card"><span>En análisis</span><strong><%= @under_analysis_count %></strong></article>
  <article class="stat-card"><span>Usuarios activos</span><strong><%= @active_users_count %></strong></article>
</section>

<section class="panel">
  <div class="panel-header">
    <h2>Últimos movimientos de custodia</h2>
    <%= link_to "Ver historial completo", admin_custody_movements_path, class: "text-link" %>
  </div>
  <div class="table-wrap">
    <table>
      <thead><tr><th>Evidencia</th><th>Origen</th><th>Destino</th><th>Fecha</th></tr></thead>
      <tbody>
        <% @recent_movements.each do |movement| %>
          <tr>
            <td><%= link_to movement.evidence.code, admin_evidence_path(movement.evidence) %></td>
            <td><%= movement.from_user&.name || "Registro inicial" %></td>
            <td><%= movement.to_user.name %></td>
            <td><%= format_datetime(movement.transferred_at) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</section>
