<header class="page-header"><div><p class="eyebrow">Accesos</p><h1>Usuarios</h1></div><%= link_to "Nuevo usuario", new_admin_user_path, class: "button primary" %></header>
<section class="panel table-wrap"><table><thead><tr><th>Nombre</th><th>Email</th><th>Rol</th><th>Estado</th><th></th></tr></thead><tbody>
  <% @users.each do |user| %><tr><td><strong><%= user.name %></strong></td><td><%= user.email %></td><td><%= human_role(user.role) %></td><td><span class="badge <%= user.active? ? "active" : "inactive" %>"><%= user.active? ? "Activo" : "Inactivo" %></span></td><td class="actions"><%= link_to "Ver", admin_user_path(user) %><%= link_to "Editar", edit_admin_user_path(user) %></td></tr><% end %>
</tbody></table></section>
