<header class="page-header"><div><p class="eyebrow">Movimiento #<%= @movement.id %></p><h1><%= @movement.evidence.code %> · <%= @movement.reason %></h1></div></header>
<section class="panel"><dl class="details"><div><dt>Fecha</dt><dd><%= format_datetime(@movement.transferred_at) %></dd></div><div><dt>Evidencia</dt><dd><%= link_to @movement.evidence.name, admin_evidence_path(@movement.evidence) %></dd></div><div><dt>Origen</dt><dd><%= @movement.from_user&.name || "—" %></dd></div><div><dt>Destino</dt><dd><%= @movement.to_user.name %></dd></div><div><dt>Realizado por</dt><dd><%= @movement.performed_by.name %></dd></div><div class="wide"><dt>Observaciones</dt><dd><%= @movement.notes.presence || "Sin observaciones" %></dd></div></dl></section>
