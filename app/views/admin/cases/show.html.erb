<header class="page-header">
  <div><p class="eyebrow">Caso</p><h1><%= @case.code %> · <%= @case.title %></h1></div>
  <%= link_to "Editar", edit_admin_case_path(@case), class: "button secondary" %>
</header>
<section class="detail-grid">
  <article class="panel">
    <h2>Información</h2>
    <dl class="details">
      <div><dt>Estado</dt><dd><span class="badge <%= @case.status %>"><%= human_status(@case.status) %></span></dd></div>
      <div><dt>Fecha de apertura</dt><dd><%= format_datetime(@case.opened_at) %></dd></div>
      <div class="wide"><dt>Descripción</dt><dd><%= @case.description.presence || "Sin descripción" %></dd></div>
    </dl>
  </article>
  <article class="panel">
    <h2>Analistas asignados</h2>
    <ul class="clean-list"><% @case.analysts.order(:name).each do |analyst| %><li><strong><%= analyst.name %></strong><span><%= analyst.email %></span></li><% end %></ul>
  </article>
</section>
<section class="panel">
  <div class="panel-header"><h2>Evidencias del caso</h2><%= link_to "Nueva evidencia", new_admin_evidence_path, class: "button small" %></div>
  <div class="table-wrap"><table><thead><tr><th>Código</th><th>Nombre</th><th>Tipo</th><th>Custodio</th><th>Estado</th></tr></thead><tbody>
    <% @evidences.each do |evidence| %><tr><td><%= link_to evidence.code, admin_evidence_path(evidence) %></td><td><%= evidence.name %></td><td><%= evidence.evidence_type.name %></td><td><%= evidence.current_custodian.name %></td><td><%= human_status(evidence.status) %></td></tr><% end %>
  </tbody></table></div>
</section>
