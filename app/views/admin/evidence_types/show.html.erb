<header class="page-header"><div><p class="eyebrow">Tipo de evidencia</p><h1><%= @evidence_type.name %></h1></div><div class="form-actions"><%= link_to "Editar", edit_admin_evidence_type_path(@evidence_type), class: "button secondary" %><%= button_to "Eliminar", admin_evidence_type_path(@evidence_type), method: :delete, class: "button secondary" %></div></header>
<section class="panel"><p><%= @evidence_type.description.presence || "Sin descripción." %></p><p class="muted"><%= pluralize(@evidence_type.evidences.count, "evidencia asociada", "evidencias asociadas") %></p></section>
