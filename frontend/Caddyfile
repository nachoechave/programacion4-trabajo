:80 {
  encode zstd gzip

  @api path /api/*
  handle @api {
    reverse_proxy {$RAILS_UPSTREAM}
  }

  handle {
    root * /srv
    try_files {path} /index.html
    file_server
  }

  header {
    X-Content-Type-Options nosniff
    Referrer-Policy strict-origin-when-cross-origin
    X-Frame-Options DENY
  }
}
